#!/bin/bash
# Dock-Starter für Cash Angel (gleiche Mechanik wie Steuerfuchs, eigener Port 8351).
#  - läuft schon dieselbe Version: nur den Browser öffnen
#  - läuft eine andere Version (alter Ordner): sauber beenden, notfalls über den Port stoppen, neu starten
#  - läuft nichts: Server im Hintergrund starten, Browser öffnen, sobald er antwortet
# Schritte stehen in ~/CashAngel/app.log, die Ausgabe des Servers in ~/CashAngel/server.log.
# macOS erwartet, dass eine App sofort „antwortet“, deshalb löst sich das Skript sofort in einen
# Hintergrundprozess auf.
if [ "$1" != "--worker" ]; then
  nohup "$0" --worker >/dev/null 2>&1 &
  disown 2>/dev/null
  exit 0
fi
PROJEKT="$(cd "$(dirname "$0")/../../.." && pwd)"
PORT="${PORT:-8351}"
URL="http://127.0.0.1:$PORT"
export CASHANGEL_HOME="${CASHANGEL_HOME:-$HOME/CashAngel}"
mkdir -p "$CASHANGEL_HOME"
LOG="$CASHANGEL_HOME/app.log"
SERVERLOG="$CASHANGEL_HOME/server.log"
export PATH="/usr/local/bin:/opt/homebrew/bin:/Library/Frameworks/Python.framework/Versions/3.12/bin:/Library/Frameworks/Python.framework/Versions/3.13/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
log(){ echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"; }
# Anführungszeichen und Backslashes raus, damit der Text sicher in das AppleScript passt.
sauber(){ tr -d '"\\' | tr '\r' ' '; }
alarm(){ log "FEHLER: $1"; osascript -e "display alert \"Cash Angel\" message \"$(printf '%s' "$1" | sauber)\" as critical" >/dev/null 2>&1; }
hinweis(){ log "$1"; osascript -e "display notification \"$(printf '%s' "$1" | sauber)\" with title \"Cash Angel\"" >/dev/null 2>&1; }
lebt(){ curl -s --max-time 1 "$URL/gesund" >/dev/null 2>&1; }
log_ende(){ tail -n 6 "$SERVERLOG" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -n 4; }

log "Start aus $PROJEKT"
LOKAL="$(cat "$PROJEKT/VERSION" 2>/dev/null || echo dev)"
if lebt; then
  LAUFEND="$(curl -s --max-time 1 "$URL/api/version" 2>/dev/null | sed -E 's/.*"version": *"([^"]*)".*/\1/')"
  log "Server läuft (Version '${LAUFEND:-unbekannt}'), lokal '$LOKAL'"
  if [ -n "$LAUFEND" ] && [ "$LAUFEND" = "$LOKAL" ]; then open "$URL"; exit 0; fi
  log "Andere Version – beende laufenden Server"
  curl -s -X POST --max-time 2 "$URL/api/beenden" >/dev/null 2>&1
  for i in $(seq 1 15); do sleep 0.3; lebt || break; done
  if lebt; then
    log "Server reagiert nicht auf Beenden – stoppe über Port $PORT"
    PIDS="$(lsof -ti tcp:"$PORT" 2>/dev/null)"
    [ -n "$PIDS" ] && kill $PIDS 2>/dev/null
    for i in $(seq 1 15); do sleep 0.3; lebt || break; done
  fi
  if lebt; then alarm "Ein anderer Cash Angel auf Port $PORT lässt sich nicht beenden. Bitte im Terminal: pkill -f 'uvicorn app.main'"; exit 1; fi
fi

# Gatekeeper-Falle: Eine frisch geladene App, die direkt im entpackten Ordner geöffnet wird, startet macOS
# als Kopie aus einem Zufallsordner (App Translocation). Dann liegt start.sh nicht mehr daneben. Wir suchen
# den echten Ordner, nehmen ihm die Quarantäne-Markierung und starten von dort neu.
if [[ "$PROJEKT" == */AppTranslocation/* ]] || [ ! -f "$PROJEKT/start.sh" ]; then
  log "Kein start.sh neben der App ($PROJEKT) – suche den Original-Ordner"
  MARKE="$CASHANGEL_HOME/.neustart"
  if [ -f "$MARKE" ] && [ $(( $(date +%s) - $(cat "$MARKE" 2>/dev/null || echo 0) )) -lt 90 ]; then
    rm -f "$MARKE"
    alarm "Cash Angel wird von macOS aus einem Zufallsordner gestartet und findet seinen Programmordner nicht. Abhilfe: Im Terminal eingeben: xattr -dr com.apple.quarantine  (mit Leerzeichen dahinter), dann den Ordner cashangel aus dem Finder ins Terminal-Fenster ziehen und Enter drücken. Danach die App erneut öffnen."
    exit 1
  fi
  ORIG=""
  passt(){ [ -f "$1/start.sh" ] && [ -f "$1/app/main.py" ]; }
  while IFS= read -r k; do
    [ -n "$k" ] || continue
    case "$k" in */AppTranslocation/*) continue;; esac
    d="$(cd "$(dirname "$k")" 2>/dev/null && pwd)" || continue
    if passt "$d"; then ORIG="$d"; break; fi
  done < <(mdfind -name "Cash Angel.app" 2>/dev/null; mdfind "kMDItemFSName == 'start.sh'" 2>/dev/null | grep -i cashangel
           find "$HOME/Downloads" "$HOME/Desktop" "$HOME/Documents" "$HOME/Programme" "$HOME/Applications" "$HOME/Library/Mobile Documents/com~apple~CloudDocs" "$HOME" /Applications /Volumes -maxdepth 6 -name "Cash Angel.app" 2>/dev/null)
  if [ -z "$ORIG" ]; then
    # Nicht gefunden: den Ordner einfach auswählen lassen (Finder-Dialog)
    log "Original nicht gefunden – frage nach dem Ordner"
    GEWAEHLT="$(osascript -e 'try' -e 'POSIX path of (choose folder with prompt "Cash Angel wurde von macOS aus einem Zufallsordner gestartet. Bitte den entpackten Ordner „cashangel“ auswählen (darin liegen start.sh und Cash Angel.app):")' -e 'on error' -e 'return ""' -e 'end try' 2>/dev/null)"
    GEWAEHLT="${GEWAEHLT%/}"
    if [ -n "$GEWAEHLT" ] && passt "$GEWAEHLT"; then ORIG="$GEWAEHLT"
    elif [ -n "$GEWAEHLT" ] && passt "$GEWAEHLT/cashangel"; then ORIG="$GEWAEHLT/cashangel"
    elif [ -n "$GEWAEHLT" ]; then alarm "Im gewählten Ordner ($GEWAEHLT) liegt keine start.sh. Bitte den Ordner wählen, in dem start.sh und Cash Angel.app nebeneinander liegen."; exit 1
    else alarm "start.sh fehlt im Ordner $PROJEKT und der Original-Ordner wurde nicht gefunden. Abhilfe: Im Terminal eingeben: xattr -dr com.apple.quarantine  (mit Leerzeichen dahinter), dann den Ordner cashangel aus dem Finder ins Terminal-Fenster ziehen und Enter drücken. Danach die App erneut öffnen."; exit 1
    fi
  fi
  log "Original gefunden: $ORIG – entferne Quarantäne und starte von dort"
  xattr -dr com.apple.quarantine "$ORIG" 2>/dev/null
  date +%s > "$MARKE"
  open "$ORIG/Cash Angel.app"
  exit 0
fi
rm -f "$CASHANGEL_HOME/.neustart"
cd "$PROJEKT" || { alarm "Programmordner nicht gefunden: $PROJEKT"; exit 1; }
chmod +x start.sh 2>/dev/null

# Erster Start (noch keine .venv) heißt: Abhängigkeiten laden. Das darf dauern – bis zu 15 Minuten warten.
if [ -d .venv ]; then WARTE=240; else WARTE=1800; hinweis "Erster Start: Cash Angel wird eingerichtet, das kann ein paar Minuten dauern …"; fi

log "Starte Server (warte bis zu $((WARTE / 2)) s)"
echo "" >> "$SERVERLOG"
CASHANGEL_KEIN_BROWSER=1 nohup ./start.sh >> "$SERVERLOG" 2>&1 &
SERVER=$!
for i in $(seq 1 "$WARTE"); do
  sleep 0.5
  if lebt; then log "Server antwortet – öffne Browser"; open "$URL"; exit 0; fi
  if ! kill -0 "$SERVER" 2>/dev/null; then
    wait "$SERVER" 2>/dev/null; RC=$?
    log "start.sh hat sich beendet (Code $RC)"
    alarm "Cash Angel konnte nicht starten. Zuletzt im Log:

$(log_ende)

Alles steht in $SERVERLOG"
    exit 1
  fi
done
alarm "Cash Angel antwortet nach $((WARTE / 2)) Sekunden noch nicht. Zuletzt im Log:

$(log_ende)

Alles steht in $SERVERLOG"
exit 1
